<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MagpieTrove.Views.ViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:MagpieTrove.Converters" Title="Magpie Trove Viewer" Height="900" Width="1400" Background="#FF101013" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterOwner" WindowState="Maximized" xmlns:views="clr-namespace:MagpieTrove.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:RatingToBrushConverter x:Key="RatingBrush" />
      <conv:PartialToOpacityConverter x:Key="PartialOpacity" />
      <conv:CountToVisibilityConverter x:Key="CountVis" />
      <Style x:Key="OverlayBar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#CC17171A" />
        <Setter Property="Border.Padding" Value="14,9" />
      </Style>
      <Style x:Key="ViewerStar" TargetType="{x:Type Button}" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Content" Value="★" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Name="Viewport" Row="1" ClipToBounds="True" Background="#FF101013" MouseWheel="OnViewportMouseWheel" MouseLeftButtonDown="OnViewportMouseDown" MouseLeftButtonUp="OnViewportMouseUp" MouseMove="OnViewportMouseMove" SizeChanged="OnViewportSizeChanged">
      <Canvas Name="ImageCanvas" ClipToBounds="True">
        <Image Name="ImageView" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
      </Canvas>
      <Grid Name="CompareSurface" Visibility="Collapsed" Background="#FF101013">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderBrush="#FF303038" BorderThickness="0,0,1,0" Margin="8,8,4,8">
          <Image Name="CompareLeft" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <Border Grid.Column="1" Margin="4,8,8,8">
          <Image Name="CompareRight" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
      </Grid>
    </Grid>
    <TextBlock Name="LoadingText" Grid.Row="1" Text="Loading…" Foreground="#FF8A8A94" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
    <Border Grid.Row="0" Style="{StaticResource OverlayBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Name="TitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Name="SubtitleText" Foreground="#FF9A9AA4" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Name="ZoomText" Foreground="#FF9A9AA4" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Button Content="Fit" Width="44" ToolTip="Fit to window (F)" Click="OnFitClick" />
          <Button Content="100%" Width="52" Margin="5,0,0,0" ToolTip="Actual size (1)" Click="OnActualSizeClick" />
          <Button Content="↶" Width="36" Margin="5,0,0,0" ToolTip="Rotate left ([)" Click="OnRotateLeftClick" />
          <Button Content="↷" Width="36" Margin="5,0,0,0" ToolTip="Rotate right (])" Click="OnRotateRightClick" />
          <Button Name="CompareButton" Content="Compare" Margin="5,0,0,0" ToolTip="Compare the two images selected when the viewer opened (C)" Click="OnCompareClick" />
          <Button Name="SlideshowButton" Content="Play" Width="46" Margin="5,0,0,0" ToolTip="Start or stop slideshow (S)" Click="OnSlideshowClick" />
          <ComboBox Name="SlideshowInterval" Width="50" Margin="4,0,0,0" ToolTip="Slideshow interval in seconds">
            <ComboBoxItem Content="2s" Tag="2" />
            <ComboBoxItem Content="3s" Tag="3" IsSelected="True" />
            <ComboBoxItem Content="5s" Tag="5" />
            <ComboBoxItem Content="10s" Tag="10" />
          </ComboBox>
          <Button Content="Close" Width="58" Margin="5,0,0,0" ToolTip="Esc" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="3" Style="{StaticResource OverlayBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <Button Style="{StaticResource ViewerStar}" CommandParameter="1" Command="{Binding SetRatingCommand}" Foreground="{Binding CurrentImage.Rating, Converter={StaticResource RatingBrush}, ConverterParameter=1}" />
          <Button Style="{StaticResource ViewerStar}" CommandParameter="2" Command="{Binding SetRatingCommand}" Foreground="{Binding CurrentImage.Rating, Converter={StaticResource RatingBrush}, ConverterParameter=2}" />
          <Button Style="{StaticResource ViewerStar}" CommandParameter="3" Command="{Binding SetRatingCommand}" Foreground="{Binding CurrentImage.Rating, Converter={StaticResource RatingBrush}, ConverterParameter=3}" />
          <Button Style="{StaticResource ViewerStar}" CommandParameter="4" Command="{Binding SetRatingCommand}" Foreground="{Binding CurrentImage.Rating, Converter={StaticResource RatingBrush}, ConverterParameter=4}" />
          <Button Style="{StaticResource ViewerStar}" CommandParameter="5" Command="{Binding SetRatingCommand}" Foreground="{Binding CurrentImage.Rating, Converter={StaticResource RatingBrush}, ConverterParameter=5}" />
          <Button Content="✕" Style="{StaticResource SubtleButton}" FontSize="11" Margin="6,0,0,0" CommandParameter="0" ToolTip="Clear rating" Command="{Binding SetRatingCommand}" />
        </StackPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Margin="0,0,16,0">
          <ItemsControl ItemsSource="{Binding SelectionTags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="10" Background="#552F6FA8" BorderBrush="#FF37373E" BorderThickness="1" Padding="9,3" Margin="0,0,5,0" Opacity="{Binding IsPartial, Converter={StaticResource PartialOpacity}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                    <Button Content="✕" FontSize="9" Margin="6,0,0,0" Padding="2,0" Style="{StaticResource SubtleButton}" Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox Name="TagEntry" Width="210" Height="26" ToolTip="Add tags to this image — press T to jump here, commas separate tags" Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnTagEntryKeyDown" />
          <Button Content="Add" Margin="6,0,0,0" Command="{Binding AddTagCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="2" Height="92" Margin="64,6" Padding="5" Background="#B817171A" BorderBrush="#FF303038" BorderThickness="1" CornerRadius="5" Panel.ZIndex="2">
      <ListBox Name="Filmstrip" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="OnFilmstripSelectionChanged">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                  <Border Name="Frame" BorderThickness="2" BorderBrush="#00FFFFFF">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="ListBoxItem.IsSelected" Value="True">
                      <Setter TargetName="Frame" Value="{StaticResource AccentBrush}" Property="Border.BorderBrush" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Width="88" Height="72" ToolTip="{Binding FileName}">
              <Image Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Source="{Binding Thumbnail}">
                <FrameworkElement.LayoutTransform>
                  <RotateTransform Angle="{Binding RotationOverride}" />
                </FrameworkElement.LayoutTransform>
              </Image>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
    </Border>
    <Button Grid.Row="1" Content="‹" FontSize="34" Width="46" Height="86" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.5" Background="#AA17171A" ToolTip="Previous (←)" Click="OnPreviousClick" />
    <Button Grid.Row="1" Content="›" FontSize="34" Width="46" Height="86" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.5" Background="#AA17171A" ToolTip="Next (→)" Click="OnNextClick" />
  </Grid>
</Window>