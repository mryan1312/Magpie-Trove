<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MagpieTrove.Views.DuplicatesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:MagpieTrove.Converters" Title="Duplicates" Height="820" Width="1180" MinHeight="500" MinWidth="820" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterOwner" xmlns:views="clr-namespace:MagpieTrove.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:BoolToVisibilityConverter x:Key="BoolVis" />
      <conv:BoolToVisibilityConverter x:Key="NotBoolVis" Invert="True" />
      <conv:CountToVisibilityConverter x:Key="CountVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,9">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Sensitivity" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
          <Slider Name="Sensitivity" Width="150" Minimum="0" Maximum="14" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ToolTip="How different two images may be and still count as duplicates. 0 finds only exact visual matches." />
          <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource FaintBrush}" Width="70" Text="{Binding Value, ElementName=Sensitivity, StringFormat={}{0:0} / 64 bits}" />
          <Button Content="Scan for duplicates" Margin="12,0,0,0" IsEnabled="{Binding IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" Click="OnScan" />
          <Button Content="Stop" Margin="6,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}, RelativeSource={RelativeSource AncestorType=Window}}" Click="OnCancel" />
        </StackPanel>
        <TextBlock Name="SummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
      <ItemsControl Name="GroupList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Margin="0,0,0,10" Padding="12">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="3" Padding="6,1" Margin="0,0,8,0" Background="{StaticResource AccentSoftBrush}">
                      <TextBlock FontSize="11" Text="{Binding Group.KindLabel}" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Group.Count, StringFormat={}{0} copies}" />
                  </StackPanel>
                  <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource FaintBrush}" Text="{Binding ReclaimText}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Entries}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="210" Margin="0,0,10,10" Padding="8" CornerRadius="5" BorderThickness="2" Background="#FF212127">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Border}">
                            <Setter Property="BorderBrush" Value="#00FFFFFF" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding Keep}">
                                <Setter Property="BorderBrush" Value="#FF6FD08C" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                        <StackPanel>
                          <Image Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Image.Thumbnail}" />
                          <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Image.FileName}" ToolTip="{Binding Image.Path}" />
                          <TextBlock FontSize="11" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                          <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding TagSummary}" Visibility="{Binding HasTags, Converter={StaticResource BoolVis}}" />
                          <Grid Margin="0,6,0,0">
                            <RadioButton Content="Keep" FontSize="11" GroupName="{Binding GroupName}" IsChecked="{Binding Keep, Mode=TwoWay}" />
                            <TextBlock Text="best" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource FaintBrush}" Visibility="{Binding IsBest, Converter={StaticResource BoolVis}}" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}" Text="Scan to look for duplicate and near-duplicate images." TextAlignment="Center" />
    <Border Grid.Row="2" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,9">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ProgressBar Name="Progress" Width="180" Height="4" Maximum="100" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}, RelativeSource={RelativeSource AncestorType=Window}}" />
          <TextBlock Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Select all best" Margin="0,0,6,0" ToolTip="Mark the highest-resolution copy in every group as the one to keep" Click="OnSelectBest" />
          <Button Name="RemoveButton" Content="Remove the rest from library..." Background="{StaticResource AccentSoftBrush}" Click="OnRemoveOthers" />
          <Button Content="Close" Width="80" Margin="6,0,0,0" Click="OnClose" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>